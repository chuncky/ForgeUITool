{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgeui.local/schemas/project.schema.json",
  "title": "ForgeUI Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "display",
    "lvglVersion",
    "previewBackend",
    "deliveryMode",
    "entrySymbol",
    "defaultScreen",
    "screens"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "platform": {
      "type": "string",
      "description": "D-08: optional SDK delivery hint only; must not drive CodeGen"
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "colorDepth"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "colorDepth": { "type": "integer", "enum": [8, 16, 24, 32] },
        "rotation": { "type": "integer", "enum": [0, 90, 180, 270] }
      }
    },
    "lvglVersion": { "type": "string", "enum": ["9.10"] },
    "previewBackend": { "type": "string", "enum": ["sdl", "wasm"] },
    "deliveryMode": { "type": "string", "enum": ["static_c", "dynamic_ui", "both"] },
    "entrySymbol": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "defaultScreen": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "file": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "images": { "type": "array" },
        "fonts": { "type": "array" }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageMode": { "type": "string", "enum": ["c_array", "fs_path"] },
        "lvglInclude": { "type": "string" },
        "codegenDir": { "type": "string" },
        "customSubdir": { "type": "string" },
        "generatedDir": { "type": "string" },
        "userDir": { "type": "string" },
        "packageDir": { "type": "string" },
        "eventStubStyle": { "type": "string", "enum": ["custom", "weak"] },
        "micropython": { "type": "boolean" }
      }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "copyTargetRel": { "type": "string" }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cPrefix": { "type": "string" },
        "screenPrefix": { "type": "string" }
      }
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "value"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "colorThemes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "colors"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "createdAt": { "type": "string" },
          "colors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "value"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "part", "state", "props"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "createdAt": { "type": "string" },
          "widgetType": { "type": "string" },
          "part": { "type": "string" },
          "state": { "type": "string" },
          "props": { "type": "object" }
        }
      }
    },
    "customWidgets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "root"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "root": { "$ref": "https://forgeui.local/schemas/screen.schema.json#/$defs/node" },
          "createdAt": { "type": "string" }
        }
      }
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "defaultLocale": { "type": "string", "minLength": 1 },
        "previewLocale": { "type": "string", "minLength": 1 },
        "locales": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string" }
            }
          }
        },
        "strings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "values"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "note": { "type": "string" },
              "values": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "duration", "tracks"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "duration": { "type": "number", "minimum": 1 },
          "loop": { "type": "boolean" },
          "tracks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "nodeId", "property", "keyframes"],
              "properties": {
                "id": { "type": "string" },
                "nodeId": { "type": "string" },
                "property": {
                  "type": "string",
                  "enum": ["x", "y", "w", "h", "opacity", "rotation"]
                },
                "keyframes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["t", "value"],
                    "properties": {
                      "t": { "type": "number", "minimum": 0 },
                      "value": { "type": "number" },
                      "easing": {
                        "type": "string",
                        "enum": ["linear", "ease_in", "ease_out", "ease_in_out"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["int", "bool", "string"] },
          "defaultValue": {}
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "width", "height", "colorDepth"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "colorDepth": { "type": "integer", "enum": [8, 16, 24, 32] }
        }
      }
    }
  }
}
